PORT=5000
NODE_ENV=production
# Database: Local MongoDB (Default) or MongoDB Atlas (Cloud Cluster)
MONGODB_URI=mongodb://127.0.0.1:27017/campus_grid
# Atlas: MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/campus_grid?retryWrites=true&w=majority
DB_NAME=campus_grid
JWT_SECRET=replace_with_strong_random_secret_at_least_32_characters
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
# Optional Mail configuration for credential dispatch
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=smtp_username
MAIL_PASSWORD=smtp_password
MAIL_FROM="CampusGrid Administration <admin@campusgrid.edu>"
